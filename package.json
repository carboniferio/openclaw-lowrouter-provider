{
  "name": "@lowrouter/openclaw-provider",
  "version": "0.1.0",
  "description": "LowRouter provider plugin for OpenClaw: EU-run, carbon-aware model router behind one OpenAI-compatible API.",
  "license": "Apache-2.0",
  "author": "carboniferio",
  "type": "module",
  "homepage": "https://lowrouter.ai/docs/integrations/openclaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/carboniferio/openclaw-lowrouter-provider"
  },
  "bugs": {
    "url": "https://github.com/carboniferio/openclaw-lowrouter-provider/issues"
  },
  "keywords": ["openclaw", "openclaw-plugin", "lowrouter", "llm", "provider"],
  "files": [
    "dist",
    "assets/icon.png",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/index.test.ts test/models.test.ts",
    "test:live": "vitest run test/lowrouter.live.test.ts",
    "gen:catalog": "npm run build && node scripts/gen-catalog.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openclaw": "2026.10.2",
    "typebox": "1.3.36",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@lowrouter/openclaw-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.2"
    },
    "compat": {
      "pluginApi": ">=2026.10.2"
    },
    "build": {
      "openclawVersion": "2026.10.2"
    }
  }
}
